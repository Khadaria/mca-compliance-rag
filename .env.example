# ─── MCA Compliance RAG — Environment Variables ───
# Copy this file to .env and fill in your values.

# LLM Provider: "gemini" (free tier) or "ollama" (fully local)
LLM_PROVIDER=gemini

# Google Gemini — Free API key from https://aistudio.google.com
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# Ollama — No key needed, just install Ollama and pull a model
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Paths
CORPUS_DIR=corpus_raw_v1
VECTOR_STORE_DIR=vector_store

# Embedding
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Retrieval
TOP_K=5

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Logging
LOG_LEVEL=INFO
